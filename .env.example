# No secrets in VITE_* variables. Empty values enable local demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Required before a public launch with Supabase Anonymous Auth.
VITE_TURNSTILE_SITE_KEY=
# Server only (same dedicated Supabase project)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for the control-plane endpoints; never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated, server-side magic-link identities allowed into /admin.
MIRAI_ADMIN_EMAILS=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_EVAL_CANDIDATE_BRANCH_ID=
# Optional Agents Platform environment/version routing (defaults to production).
ELEVENLABS_ENVIRONMENT=production
# Bootstrap only. Leave false in production after installing the reviewed prompt.
ELEVENLABS_ENABLE_PROMPT_OVERRIDE=false
# Optional semantic extraction. Without this, evidence-based rules are used.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
PORT=3001
