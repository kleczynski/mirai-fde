{
  "name": "mirai-discovery-interview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "workspaces": [
    "services/brief-studio"
  ],
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/domain.test.ts tests/database.test.ts tests/scene.test.ts tests/scene-transitions.test.ts tests/interviewer-flow.test.ts tests/admin.test.ts tests/admin-router.test.ts tests/demos.test.ts tests/voice-focus.test.ts tests/voice-evidence.test.ts tests/voice-closing.test.ts tests/voice-evaluation.test.ts tests/voice-trace.test.ts tests/infrastructure.test.ts",
    "test:e2e": "playwright test",
    "schema": "tsx scripts/export-schema.ts",
    "schema:build-brief": "tsx scripts/export-build-brief-schema.ts",
    "check": "npm run lint && npm test && npm run build",
    "test:infra": "vitest run tests/infrastructure.test.ts",
    "test:brief-studio": "vitest run services/brief-studio/tests/contract.test.ts",
    "dev:brief-studio": "npm run dev --workspace=services/brief-studio",
    "types:brief-studio": "npm run types --workspace=services/brief-studio",
    "typecheck:brief-studio": "npm run typecheck --workspace=services/brief-studio",
    "elevenlabs:configure": "tsx scripts/configure-elevenlabs.ts",
    "eval:voice": "tsx scripts/voice-evals.ts"
  },
  "dependencies": {
    "@elevenlabs/client": "^0.15.0",
    "@fontsource-variable/geologica": "^5.2.0",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.186.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
